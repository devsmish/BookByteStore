# MySQL Read
MYSQL_READ_HOST=localhost
MYSQL_READ_PORT=3306
MYSQL_READ_USER=bookstore_read
MYSQL_READ_PASSWORD=

# MySQL Write
MYSQL_EDIT_HOST=localhost
MYSQL_EDIT_PORT=3306
MYSQL_EDIT_USER=bookstore_edit
MYSQL_EDIT_PASSWORD=

MYSQL_DB_NAME=bookstore_db

# MongoDB
MONGO_URI=mongodb://user:password@host/?readPreference=primary&ssl=false&authMechanism=DEFAULT&authSource=admin
MONGO_DB_NAME=user
MONGO_COLLECTION_NAME=bookstore_log

# Admins
# Comma-separated usernames with access to the book management panel.
ADMIN_USERNAMES=admin

# Logging
# LOG_FILE=bookstore.log
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Docker
MYSQL_ROOT_PASSWORD=changeme_root
MONGO_ROOT_PASSWORD=changeme_root

# Integration tests
BBS_TEST_DB_HOST=localhost
BBS_TEST_DB_PORT=3306
BBS_TEST_DB_USER=root
BBS_TEST_DB_PASSWORD=your_secret_password
BBS_TEST_DB_NAME=bookstore_test  # The name MUST contain 'test'
